#!/usr/bin/env bash
# Run a coding agent in a rootless Podman container.
#
# Usage:
#   agent-capsule [OPTIONS] [PROJECT_DIR] [-- AGENT_ARGS...]
#
# Options:
#   --agent NAME           claude (default), codex, opencode, or list
#   --session NAME         use a named isolated home
#   --auth-login           authenticate the selected agent
#   --shell                start bash instead of the agent
#   --offline              disable container networking
#   --keep-id              run with the host UID and GID inside
#   --with TOOLS           activate integrations, or use list or none
#   -m, --mount SPEC       mount SRC[:DEST][:ro], repeatable
#   --vault[=PATH]         mount the configured or given vault (default /vault)
#   --no-vault             disable the vault and mcpvault for this run
#   --shared-rules PATH    select the global rules file
#   --shared-rules-rw      mount the global rules file read-write
#   --no-shared-rules      disable the global rules file
#   --shared-memory-ro     mount Claude project memory read-only
#   --no-shared-memory     disable Claude project memory
#   --build                rebuild the image from scratch
#   --versions             print configured tool versions
#   --version              print the launcher version
#   -h, --help             show this help
#
# Integrations:
#   superpowers, explain-diff, mcpvault, anydoc
#   mcpvault requires --vault. anydoc is available only with claude.
#
# Documentation: https://github.com/Niahh/agent-capsule
#
set -euo pipefail

# The image build is the only critical section, and there is one image, so one
# lock. Assigned only after the atomic file creation wins, or the EXIT trap
# would delete a lock this process does not own.
BUILD_LOCK_PATH=""
trap 'if [[ -n "$BUILD_LOCK_PATH" ]]; then rm -f "$BUILD_LOCK_PATH"; fi' EXIT

acquire_build_lock() {
  local lock_path="$1"
  local announced=0
  local lock_owner=""
  local stale_path=""

  while ! (set -o noclobber; printf '%s\n' "$$" > "$lock_path") 2>/dev/null; do
    # Versions before 0.3 used a directory lock with no owner metadata. It may
    # belong to a live older launcher, so only the user can decide it is stale.
    if [[ -d "$lock_path" ]]; then
      echo "Legacy directory lock found: $lock_path" >&2
      echo "Wait for older builds to finish, then remove the legacy directory lock." >&2
      return 1
    elif [[ -f "$lock_path" ]]; then
      lock_owner="$(<"$lock_path")"
      if [[ "$lock_owner" =~ ^[0-9]+$ ]] && ! kill -0 "$lock_owner" 2>/dev/null; then
        stale_path="$lock_path.stale.$$"
        if mv "$lock_path" "$stale_path" 2>/dev/null; then
          rm -f "$stale_path"
          continue
        fi
      fi
    fi

    if [[ "$announced" == "0" ]]; then
      echo ">> Build   : waiting for another agent-capsule to finish the image" >&2
      announced=1
    fi
    sleep 0.1
  done
  BUILD_LOCK_PATH="$lock_path"
}

release_build_lock() {
  rm -f "$BUILD_LOCK_PATH"
  BUILD_LOCK_PATH=""
}

# ----------------------------------------------------------------------------
# Config
# ----------------------------------------------------------------------------
VERSION="0.2.2"

usage() {
  awk 'NR==1{next} !/^#/{exit} {sub(/^# ?/,""); print}' "$0"
}

# ----------------------------------------------------------------------------
# Defaults (the environment is the only configuration channel)
# ----------------------------------------------------------------------------
# Everything persistent lives under this root: homes/, auth-home/, build/.
STATE_DIR="${AGENT_CAPSULE_HOME:-$HOME/.agent-capsule}"

IMAGE_NAME="${AGENT_CAPSULE_IMAGE:-agent-capsule-dev}"
NODE_TAG="${AGENT_CAPSULE_NODE_TAG:-trixie-slim}"
GO_TAG="${AGENT_CAPSULE_GO_TAG:-trixie}"
CLAUDE_CODE_VERSION="${AGENT_CAPSULE_CLAUDE_CODE_VERSION:-}"
CODEX_VERSION="${AGENT_CAPSULE_CODEX_VERSION:-}"
OPENCODE_VERSION="${AGENT_CAPSULE_OPENCODE_VERSION:-}"
ANYDOC_VERSION="${AGENT_CAPSULE_ANYDOC_VERSION:-}"
MCPVAULT_VERSION="${AGENT_CAPSULE_MCPVAULT_VERSION:-}"
SKILLS_VERSION="${AGENT_CAPSULE_SKILLS_VERSION:-}"
SUPERPOWERS_VERSION="${AGENT_CAPSULE_SUPERPOWERS_VERSION:-}"
GOLANGCI_LINT_VERSION="${AGENT_CAPSULE_GOLANGCI_LINT_VERSION:-}"

# Unpinned tools track latest at build time, so an old image quietly stops doing
# that. Age is the only signal for it: the bundle hash cannot see upstream move.
MAX_IMAGE_AGE_DAYS="${AGENT_CAPSULE_MAX_IMAGE_AGE_DAYS:-7}"

# Each rebuild strands the image it replaced. Set to 0 to keep them.
PRUNE_IMAGES="${AGENT_CAPSULE_PRUNE:-1}"

# CLI to run inside the capsule. --agent overrides this. Only the selected CLI is
# installed, so changing it rebuilds the image.
AGENT="${AGENT_CAPSULE_AGENT:-claude}"

# Empty pins mean latest, which --versions has to say out loud.
selected_version() {
  printf '%s' "${1:-latest}"
}

# Bundled integrations that --with can activate (none by default). The order is
# canonical so status output does not depend on how the user spelled the list.
KNOWN_EXTRAS=(anydoc explain-diff mcpvault superpowers)

BUILD_DIR="$STATE_DIR/build"
AUTH_ROOT_DIR="$STATE_DIR/auth-home"

# One rules file for every agent; only the in-container mount target differs
# per agent (AGENT_RULES_REL).
SHARED_RULES="${AGENT_CAPSULE_SHARED_RULES:-$STATE_DIR/CLAUDE.md}"
SHARED_RULES_ENABLED="${AGENT_CAPSULE_SHARED_RULES_ENABLED:-1}"
SHARED_RULES_READONLY="${AGENT_CAPSULE_SHARED_RULES_READONLY:-1}"

# Shared per-project memory (claude only; the container path comes from the
# agent profile). Keyed by project (not session) so parallel agents on the
# same repo pool what they learn, while transcripts and settings stay
# per-session isolated. Default: enabled, read-write (agents must write to
# share learnings). Set read-only for a curated one-way broadcast; disable to
# restore full isolation.
SHARED_MEMORY_ENABLED="${AGENT_CAPSULE_SHARED_MEMORY_ENABLED:-1}"
SHARED_MEMORY_READONLY="${AGENT_CAPSULE_SHARED_MEMORY_READONLY:-0}"

DEFAULT_MEMORY="${AGENT_CAPSULE_MEMORY:-8g}"
DEFAULT_CPUS="${AGENT_CAPSULE_CPUS:-4}"
DEFAULT_PIDS_LIMIT="${AGENT_CAPSULE_PIDS_LIMIT:-512}"

SHARE_AUTH="${AGENT_CAPSULE_SHARE_AUTH:-1}"

# Obsidian vault. Mounted read-write at $VAULT_DEST when --vault is given.
VAULT_DIR="${AGENT_CAPSULE_VAULT:-}"
VAULT_DEST="${AGENT_CAPSULE_VAULT_DEST:-/vault}"

# Claude receives capsule-generated MCP servers through a file in the session
# home, which is bind-mounted at /home/dev, and the --mcp-config flag.
MCP_CONFIG_BASENAME=".mcp-servers.json"
CONTAINER_MCP_CONFIG="/home/dev/$MCP_CONFIG_BASENAME"

# ----------------------------------------------------------------------------
# Agent profiles
# ----------------------------------------------------------------------------
# The one place that knows agent-specific runtime behavior. Adding an agent also
# requires one KNOWN_AGENTS entry and one arm in the Dockerfile's AGENT case.
KNOWN_AGENTS=(claude codex opencode)

load_agent_profile() {
  case "$1" in
    claude)
      AGENT_BIN=claude
      # What --auth-login runs; claude's login is in-app.
      AGENT_AUTH_CMD=(claude)
      # Copied from the auth home into new session homes (minus the live
      # credentials file). Also the probe for "has this agent been used here?".
      AGENT_AUTH_COPY_PATHS=(".claude" ".claude.json")
      # The one live-shared (rw bind mount) credentials file, rel to $HOME.
      AGENT_CRED_REL=".claude/.credentials.json"
      # Where the shared rules file is mounted, rel to /home/dev.
      AGENT_RULES_REL=".claude/CLAUDE.md"
      AGENT_SKILLS_REL=".claude/skills"
      # flag: pass a generated file with --mcp-config.
      # override: use CLI settings. env: merge invocation-scoped config.
      AGENT_MCP_MODE="flag"
      # API keys passed through by name only (values stay off the podman argv).
      AGENT_ENV_PASS=(ANTHROPIC_API_KEY)
      AGENT_AUTH_DEVICE_DEFAULT=0
      ;;
    codex)
      AGENT_BIN=codex
      AGENT_AUTH_CMD=(codex login)
      AGENT_AUTH_COPY_PATHS=(.codex)
      AGENT_CRED_REL=.codex/auth.json
      AGENT_RULES_REL=.codex/AGENTS.md
      AGENT_SKILLS_REL=.codex/skills
      AGENT_MCP_MODE="override"
      AGENT_ENV_PASS=(OPENAI_API_KEY)
      AGENT_AUTH_DEVICE_DEFAULT=1
      ;;
    opencode)
      AGENT_BIN=opencode
      AGENT_AUTH_CMD=(opencode auth login)
      # Nothing is copied: the live credentials mount suffices, and copying
      # .local/share/opencode would drag another session's transcripts along.
      AGENT_AUTH_COPY_PATHS=()
      AGENT_CRED_REL=".local/share/opencode/auth.json"
      AGENT_RULES_REL=".config/opencode/AGENTS.md"
      AGENT_SKILLS_REL=".config/opencode/skills"
      AGENT_MCP_MODE="env"
      AGENT_ENV_PASS=(ANTHROPIC_API_KEY OPENAI_API_KEY)
      AGENT_AUTH_DEVICE_DEFAULT=0
      ;;
    *)
      echo "Unknown agent: $1 (known: ${KNOWN_AGENTS[*]})" >&2
      exit 1
      ;;
  esac
}

# ----------------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------------
sanitize_name() {
  local raw="${1:-}"
  local cleaned

  cleaned="$(printf '%s' "$raw" | tr -cd 'a-zA-Z0-9_.-')"
  printf '%s' "$cleaned"
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "$1 is not installed or not on PATH." >&2
    exit 1
  }
}

ensure_minimal_gitconfig() {
  local target_home="$1"
  local gitconfig="$target_home/.gitconfig"

  if [[ -f "$gitconfig" ]]; then
    return 0
  fi

  touch "$gitconfig"

  if command -v git >/dev/null 2>&1; then
    git config --file "$gitconfig" init.defaultBranch main

    local git_name
    local git_email

    git_name="$(git config --global user.name 2>/dev/null || true)"
    git_email="$(git config --global user.email 2>/dev/null || true)"

    [[ -n "$git_name" ]] && git config --file "$gitconfig" user.name "$git_name"
    [[ -n "$git_email" ]] && git config --file "$gitconfig" user.email "$git_email"
  else
    cat > "$gitconfig" <<'GITCONFIG'
[init]
	defaultBranch = main
GITCONFIG
  fi

  # Do not let the last conditional's exit status leak out: with no global
  # git email the trailing [[ -n "" ]] returns 1 and, under set -e, would
  # abort the whole script on a fresh session home.
  return 0
}

copy_path_if_present() {
  local from_home="$1"
  local to_home="$2"
  local rel_path="$3"

  if [[ ! -e "$from_home/$rel_path" ]]; then
    return 0
  fi

  mkdir -p "$to_home/$(dirname "$rel_path")"
  cp -a "$from_home/$rel_path" "$to_home/$rel_path"
}

session_has_agent_state() {
  local target_home="$1"
  local rel

  for rel in "${AGENT_AUTH_COPY_PATHS[@]}"; do
    [[ -e "$target_home/$rel" ]] && return 0
  done

  return 1
}

copy_agent_auth_from_auth_home() {
  local auth_home="$1"
  local session_home="$2"
  local rel

  [[ "$SHARE_AUTH" == "1" ]] || return 0
  [[ "$session_home" != "$auth_home" ]] || return 0

  # Agents with an empty copy list rely on the live credentials mount alone.
  [[ "${#AGENT_AUTH_COPY_PATHS[@]}" -gt 0 ]] || return 0

  if session_has_agent_state "$session_home"; then
    return 0
  fi

  if ! session_has_agent_state "$auth_home"; then
    echo ">> Auth    : no shared auth found yet. Run: agent-capsule --agent $AGENT --auth-login" >&2
    return 0
  fi

  for rel in "${AGENT_AUTH_COPY_PATHS[@]}"; do
    copy_path_if_present "$auth_home" "$session_home" "$rel"
  done

  # Don't leave the OAuth token sprawled across every session home: the live
  # credentials are bind-mounted read-write at runtime (see SHARED_CRED_MOUNTED),
  # so the copy above is redundant and would strand a stale token on disk.
  rm -f "$session_home/$AGENT_CRED_REL"

  echo ">> Auth    : copied shared $AGENT auth into this session"
}

# A session home stays bound to the agent that created it: sharing one home
# across agents would silently mix their state. Each agent also gets a separate
# auth home, so login sessions never expose another agent's credentials.
ensure_session_agent_marker() {
  local session_home="$1"
  local marker="$session_home/.agent"
  local owner

  if [[ -f "$marker" ]]; then
    owner="$(<"$marker")"
  else
    owner="$AGENT"
    printf '%s\n' "$owner" > "$marker"
  fi

  if [[ "$owner" != "$AGENT" ]]; then
    echo "Session '$SESSION_NAME' was created by agent '$owner'." >&2
    echo "Rerun with --agent $owner, or pick another --session." >&2
    exit 1
  fi
}

resolve_file_path() {
  local path="$1"
  local must_exist="${2:-0}"
  local dir
  local base

  dir="$(dirname "$path")"
  base="$(basename "$path")"

  # A path that exists but is not a regular file (typically a directory) must
  # never be mounted where a file is expected.
  if [[ -e "$path" && ! -f "$path" ]]; then
    echo "Not a regular file: $path" >&2
    exit 1
  fi

  if [[ ! -e "$path" ]]; then
    # An explicitly requested file that is missing is almost always a typo;
    # only auto-create the built-in default.
    if [[ "$must_exist" == "1" ]]; then
      echo "File not found: $path" >&2
      exit 1
    fi
    mkdir -p "$dir"
    touch "$path"
    chmod 600 "$path" 2>/dev/null || true
  fi

  dir="$(cd "$dir" 2>/dev/null && pwd)" || {
    echo "Cannot resolve directory for file: $path" >&2
    exit 1
  }

  printf '%s/%s' "$dir" "$base"
}

resolve_script_dir() {
  local src="${BASH_SOURCE[0]}"
  local dir

  while [[ -h "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done

  cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}

resolve_dockerfile() {
  if [[ -n "${AGENT_CAPSULE_DOCKERFILE:-}" ]]; then
    [[ -f "$AGENT_CAPSULE_DOCKERFILE" ]] || {
      echo "Dockerfile not found: $AGENT_CAPSULE_DOCKERFILE" >&2
      exit 1
    }
    printf '%s' "$AGENT_CAPSULE_DOCKERFILE"
    return
  fi

  local script_dir
  script_dir="$(resolve_script_dir)"

  local candidates=(
    "$script_dir/Dockerfile"
    "$script_dir/../share/agent-capsule/Dockerfile"
  )

  local c
  for c in "${candidates[@]}"; do
    [[ -f "$c" ]] && {
      printf '%s' "$c"
      return
    }
  done

  echo "Cannot find Dockerfile (looked in: ${candidates[*]})." >&2
  echo "Set AGENT_CAPSULE_DOCKERFILE to point at it explicitly." >&2
  exit 1
}

# ----------------------------------------------------------------------------
# Parse args
# ----------------------------------------------------------------------------
FORCE_BUILD=0
SHELL_MODE=0
ARGS_ONLY=0
AUTH_LOGIN=0
KEEP_ID="${AGENT_CAPSULE_KEEPID:-0}"
OFFLINE="${AGENT_CAPSULE_OFFLINE:-0}"
SESSION_NAME="${AGENT_CAPSULE_SESSION:-}"
DISABLE_SHARED_RULES=0
SHARED_RULES_EXPLICIT=0
SESSION_EXPLICIT=0
MOUNT_VAULT="${AGENT_CAPSULE_MOUNT_VAULT:-0}"
NO_VAULT=0
MOUNT_SPECS=()

# Seeded from the environment. The first CLI --with replaces that seed instead
# of adding to it, otherwise an ambient default extra could never be dropped for
# a single run (--with none then selects nothing at all).
EXTRAS_REQUESTED=()
[[ -n "${AGENT_CAPSULE_WITH:-}" ]] && EXTRAS_REQUESTED=("$AGENT_CAPSULE_WITH")
WITH_EXPLICIT=0

while [[ "${1:-}" == -? || "${1:-}" == --* ]]; do
  # Split the =VALUE form once, so each value-taking flag is implemented once.
  # --vault is deliberately absent: its bare form takes no separate value.
  case "$1" in
    --agent=* | --session=* | --shared-rules=* | --with=* | --mount=*)
      set -- "${1%%=*}" "${1#*=}" "${@:2}"
      ;;
  esac

  case "$1" in
    --build)
      FORCE_BUILD=1
      shift
      ;;
    --shell)
      SHELL_MODE=1
      shift
      ;;
    --keep-id)
      KEEP_ID=1
      shift
      ;;
    --offline)
      OFFLINE=1
      shift
      ;;
    --auth-login)
      AUTH_LOGIN=1
      shift
      ;;
    --agent)
      [[ -n "${2:-}" ]] || {
        echo "--agent requires a name (or 'list'). Known: ${KNOWN_AGENTS[*]}" >&2
        exit 1
      }
      [[ "$2" == "list" ]] && {
        printf '%s\n' "${KNOWN_AGENTS[@]}"
        exit 0
      }
      AGENT="$2"
      shift 2
      ;;
    --session)
      [[ -n "${2:-}" ]] || {
        echo "--session requires a name." >&2
        exit 1
      }
      SESSION_NAME="$2"
      SESSION_EXPLICIT=1
      shift 2
      ;;
    --shared-rules)
      [[ -n "${2:-}" ]] || {
        echo "$1 requires a file path." >&2
        exit 1
      }
      SHARED_RULES="$2"
      SHARED_RULES_ENABLED=1
      SHARED_RULES_EXPLICIT=1
      shift 2
      ;;
    --no-shared-rules)
      DISABLE_SHARED_RULES=1
      shift
      ;;
    --shared-rules-rw)
      SHARED_RULES_READONLY=0
      shift
      ;;
    --no-shared-memory)
      SHARED_MEMORY_ENABLED=0
      shift
      ;;
    --shared-memory-ro)
      SHARED_MEMORY_READONLY=1
      shift
      ;;
    --with)
      [[ -n "${2:-}" ]] || {
        echo "--with requires a tool list (or 'list'/'none'). Known: ${KNOWN_EXTRAS[*]}" >&2
        exit 1
      }
      [[ "$2" == "list" ]] && {
        printf '%s\n' "${KNOWN_EXTRAS[@]}"
        exit 0
      }
      [[ "$WITH_EXPLICIT" == "0" ]] && EXTRAS_REQUESTED=()
      WITH_EXPLICIT=1
      EXTRAS_REQUESTED+=("$2")
      shift 2
      ;;
    -m|--mount)
      [[ -n "${2:-}" ]] || {
        echo "--mount requires an argument: SRC[:DEST][:ro]" >&2
        exit 1
      }
      MOUNT_SPECS+=("$2")
      shift 2
      ;;
    --vault)
      # Bare form only: a space-separated optional path would be ambiguous with
      # the positional PROJECT_DIR (--vault ~/code/app must keep meaning
      # "default vault, project app"). Overrides use --vault=PATH.
      MOUNT_VAULT=1
      NO_VAULT=0
      shift
      ;;
    --no-vault)
      MOUNT_VAULT=0
      NO_VAULT=1
      shift
      ;;
    --vault=*)
      [[ -n "${1#--vault=}" ]] || {
        echo "--vault= requires a directory path." >&2
        exit 1
      }
      VAULT_DIR="${1#--vault=}"
      MOUNT_VAULT=1
      NO_VAULT=0
      shift
      ;;
    --version)
      echo "agent-capsule $VERSION"
      exit 0
      ;;
    --versions)
      cat <<VERSIONS
agent-capsule $VERSION
claude-code $(selected_version "$CLAUDE_CODE_VERSION")
codex $(selected_version "$CODEX_VERSION")
opencode $(selected_version "$OPENCODE_VERSION")
anydoc $(selected_version "$ANYDOC_VERSION")
mcpvault $(selected_version "$MCPVAULT_VERSION")
skills $(selected_version "$SKILLS_VERSION")
superpowers $(selected_version "$SUPERPOWERS_VERSION")
golangci-lint $(selected_version "$GOLANGCI_LINT_VERSION")
VERSIONS
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      ARGS_ONLY=1
      shift
      break
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
done

load_agent_profile "$AGENT"
AUTH_HOME_DIR="$AUTH_ROOT_DIR/$AGENT"

# Superpowers documents these opt-outs. Passing them by name keeps their values
# out of the podman command line, like the provider API keys above.
AGENT_ENV_PASS+=(
  SUPERPOWERS_DISABLE_TELEMETRY
  DISABLE_TELEMETRY
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC
)

# Per-project memory is a Claude Code mechanism; other agents get it disabled
# outright (the memory flags become accepted no-ops).
[[ "$AGENT" == "claude" ]] || SHARED_MEMORY_ENABLED=0
if [[ "$DISABLE_SHARED_RULES" == "1" ]]; then
  SHARED_RULES_ENABLED=0
fi

# --auth-login runs in its own dedicated home, so an explicit --session would
# be silently ignored. Reject the combination instead. A session coming from
# the environment is an ambient default and is fine to ignore.
if [[ "$AUTH_LOGIN" == "1" && "$SESSION_EXPLICIT" == "1" ]]; then
  echo "--auth-login uses its own session; do not combine it with --session." >&2
  exit 1
fi

# Agent login flows need the network. An auth-home shell remains useful offline
# for inspection and repair because it does not start a login command.
if [[ "$AUTH_LOGIN" == "1" && "$OFFLINE" == "1" && "$SHELL_MODE" != "1" ]]; then
  echo "--auth-login cannot be combined with --offline (the login needs the network)." >&2
  exit 1
fi

if [[ "$ARGS_ONLY" == "1" ]]; then
  PROJECT_DIR="$PWD"
else
  PROJECT_DIR="${1:-$PWD}"
  if [[ -n "${1:-}" ]]; then shift; fi
  if [[ -n "${1:-}" && "$1" != "--" ]]; then
    echo "Unexpected argument: $1 (pass $AGENT args after --)" >&2
    exit 1
  fi
  [[ "${1:-}" == "--" ]] && shift
fi

AGENT_ARGS=("$@")

# --shell replaces the whole command with bash, so any agent args after --
# would be silently discarded. Fail instead of ignoring them.
if [[ "$SHELL_MODE" == "1" && "${#AGENT_ARGS[@]}" -gt 0 ]]; then
  echo "--shell does not take $AGENT args (got: ${AGENT_ARGS[*]})" >&2
  exit 1
fi

# ----------------------------------------------------------------------------
# Validate environment
# ----------------------------------------------------------------------------
for package_version in \
  "$CLAUDE_CODE_VERSION" \
  "$CODEX_VERSION" \
  "$OPENCODE_VERSION" \
  "$ANYDOC_VERSION" \
  "$MCPVAULT_VERSION" \
  "$SKILLS_VERSION"; do
  [[ -n "$package_version" ]] || continue
  if [[ ! "$package_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$ ]]; then
    echo "Invalid pinned package version: $package_version" >&2
    exit 1
  fi
done
unset package_version

for tagged_version in "$SUPERPOWERS_VERSION" "$GOLANGCI_LINT_VERSION"; do
  [[ -n "$tagged_version" ]] || continue
  if [[ ! "$tagged_version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$ ]]; then
    echo "Invalid pinned tagged version: $tagged_version" >&2
    exit 1
  fi
done
unset tagged_version

if [[ ! "$MAX_IMAGE_AGE_DAYS" =~ ^[0-9]+$ ]]; then
  echo "Invalid AGENT_CAPSULE_MAX_IMAGE_AGE_DAYS: $MAX_IMAGE_AGE_DAYS (whole days, 0 disables)." >&2
  exit 1
fi

require_cmd podman
require_cmd awk
require_cmd tr
require_cmd date

if command -v sha256sum >/dev/null 2>&1; then
  SHA256_COMMAND=(sha256sum)
elif command -v shasum >/dev/null 2>&1; then
  # macOS provides shasum instead of GNU coreutils' sha256sum.
  SHA256_COMMAND=(shasum -a 256)
else
  echo "sha256sum or shasum is required but neither is installed or on PATH." >&2
  exit 1
fi

# podman build moves the tag, leaving the image it replaced behind untagged.
# Two things keep this safe: only images this tool labelled are candidates, so
# podman's own intermediate layers are untouched, and only untagged ones are, so
# a differently named AGENT_CAPSULE_IMAGE survives. rmi refuses an image a
# container still uses, which is why a failure here is not an error.
prune_superseded_images() {
  local removed=0
  local image_id

  [[ "$PRUNE_IMAGES" != "0" ]] || return 0

  while read -r image_id; do
    [[ -n "$image_id" ]] || continue
    if podman rmi "$image_id" >/dev/null 2>&1; then
      removed=$((removed + 1))
    fi
  done < <(
    podman images --filter 'label=io.agent-capsule.bundle' \
      --filter 'dangling=true' --format '{{.ID}}' 2>/dev/null || true
  )

  if [[ "$removed" -gt 0 ]]; then
    echo ">> Pruned  : $removed superseded image(s)"
  fi
}

refresh_is_stale() { # refreshed-epoch
  local refreshed="$1"

  [[ "$MAX_IMAGE_AGE_DAYS" != "0" ]] || return 1
  [[ "$(($(date +%s) - refreshed))" -gt "$((MAX_IMAGE_AGE_DAYS * 86400))" ]]
}

sha256_stream() {
  "${SHA256_COMMAND[@]}" | awk '{print $1}'
}

sha256_file() {
  "${SHA256_COMMAND[@]}" "$1" | awk '{print $1}'
}

# ----------------------------------------------------------------------------
# Resolve the requested runtime integrations
# ----------------------------------------------------------------------------
# Accept repeated flags and comma-separated lists, then rebuild the selection in
# KNOWN_EXTRAS order so it is deduplicated and canonical: --with a,b and
# --with b --with a --with a must produce the same runtime selection.
EXTRAS=""
SELECT_NONE=0
REQUESTED_EXTRAS=()

if [[ "${#EXTRAS_REQUESTED[@]}" -gt 0 ]]; then
  # tr does two jobs here: fold case, and split the comma lists into words.
  read -r -a REQUESTED_EXTRAS <<<"$(printf '%s ' "${EXTRAS_REQUESTED[@]}" | tr 'A-Z,' 'a-z ')"
fi

for req in "${REQUESTED_EXTRAS[@]}"; do
  case "$req" in
    none)
      SELECT_NONE=1
      ;;
    *)
      known=0
      for extra in "${KNOWN_EXTRAS[@]}"; do
        [[ "$req" == "$extra" ]] && known=1 && break
      done
      [[ "$known" == "1" ]] || {
        echo "Unknown extra tool: $req (known: ${KNOWN_EXTRAS[*]})" >&2
        exit 1
      }
      ;;
  esac
done

# Combining `none` with real tools is contradictory; silently dropping the
# tools would look like they were selected.
if [[ "$SELECT_NONE" == "1" ]]; then
  for req in "${REQUESTED_EXTRAS[@]}"; do
    [[ "$req" == "none" ]] || {
      echo "--with none cannot be combined with other tools (got: $req)" >&2
      exit 1
    }
  done
fi

# Authentication uses a dedicated home without project integrations or mounts.
if [[ "$AUTH_LOGIN" == "1" ]]; then
  REQUESTED_EXTRAS=()
  SHARED_MEMORY_ENABLED=0
  MOUNT_VAULT=0
fi

# Emit in canonical order. Agent-specific integrations never activate under an
# unsupported agent: an explicit --with fails loudly, while an ambient default
# is dropped so a persistent AGENT_CAPSULE_WITH does not block switching agents.
for extra in "${KNOWN_EXTRAS[@]}"; do
  for req in "${REQUESTED_EXTRAS[@]}"; do
    [[ "$req" == "$extra" ]] || continue
    # anydoc ships files for ~/.claude and is useless to the other agents.
    if [[ "$extra" != "anydoc" || "$AGENT" == "claude" ]]; then
      EXTRAS="${EXTRAS:+$EXTRAS,}$extra"
    elif [[ "$WITH_EXPLICIT" == "1" ]]; then
      echo "Extra '$extra' is not available with --agent $AGENT." >&2
      exit 1
    else
      echo ">> Extras  : dropping '$extra' (unsupported by agent $AGENT)" >&2
    fi
    break
  done
done

# One tag for every selection: the io.agent-capsule.bundle label decides whether
# what it points at matches what this run asked for.
if [[ "${IMAGE_NAME##*/}" == *:* ]]; then
  IMAGE_REF="$IMAGE_NAME"
else
  IMAGE_REF="$IMAGE_NAME:latest"
fi

# Resolve physically (-P): a repo reached via a symlink and via its real path
# must hash to the same PROJECT_HASH, or shared per-project memory splits in two.
RESOLVED_DIR="$(cd -P "$PROJECT_DIR" 2>/dev/null && pwd)" || {
  echo "Directory not found: $PROJECT_DIR" >&2
  exit 1
}
PROJECT_DIR="$RESOLVED_DIR"
CONTAINER_PROJECT_DIR="$PROJECT_DIR"

# Git records absolute paths for linked worktrees by default. Running at the
# host-identical path keeps new worktree metadata valid outside the container.
# Existing linked worktrees also need their common Git directory mounted at its
# original path because it normally lives outside the selected worktree.
GIT_COMMON_DIR=""
GIT_COMMON_EXTERNAL=0
GIT_MAIN_WORKTREE=""
GIT_COMMON_RAW=""

if command -v git >/dev/null 2>&1 && git -C "$PROJECT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  GIT_COMMON_RAW="$(git -C "$PROJECT_DIR" rev-parse --git-common-dir)"
  case "$GIT_COMMON_RAW" in
    /*) GIT_COMMON_DIR="$GIT_COMMON_RAW" ;;
    *) GIT_COMMON_DIR="$PROJECT_DIR/$GIT_COMMON_RAW" ;;
  esac
  GIT_COMMON_DIR="$(cd -P "$GIT_COMMON_DIR" 2>/dev/null && pwd)" || {
    echo "Cannot resolve the Git common directory for: $PROJECT_DIR" >&2
    exit 1
  }

  GIT_MAIN_WORKTREE="$(
    git -C "$PROJECT_DIR" worktree list --porcelain 2>/dev/null |
      awk '/^worktree / { sub(/^worktree /, ""); print; exit }'
  )"
  if [[ -n "$GIT_MAIN_WORKTREE" ]]; then
    GIT_MAIN_WORKTREE="$(cd -P "$GIT_MAIN_WORKTREE" 2>/dev/null && pwd)" || GIT_MAIN_WORKTREE=""
  fi

  GIT_TOPLEVEL="$(git -C "$PROJECT_DIR" rev-parse --show-toplevel 2>/dev/null)" || GIT_TOPLEVEL=""

  case "$GIT_COMMON_DIR" in
    "$PROJECT_DIR" | "$PROJECT_DIR"/*) ;;
    *)
      # Only a worktree launched at its top level owns the external common
      # dir. From a plain subdirectory the repository .git also resolves
      # here, and mounting it without its worktree would present the whole
      # repo as deleted inside the container.
      [[ "$GIT_TOPLEVEL" == "$PROJECT_DIR" ]] && GIT_COMMON_EXTERNAL=1 ;;
  esac
elif [[ -f "$PROJECT_DIR/.git" ]]; then
  echo "Cannot use linked worktree or submodule without a working host git command: $PROJECT_DIR" >&2
  exit 1
fi

project_hash_full="$(printf '%s' "$PROJECT_DIR" | sha256_stream)"
PROJECT_HASH="${project_hash_full:0:12}"
PROJECT_BASENAME="$(sanitize_name "$(basename "$PROJECT_DIR")")"
# A leading dot is rejected below, and a project directory may well be hidden.
while [[ "$PROJECT_BASENAME" == .* ]]; do
  PROJECT_BASENAME="${PROJECT_BASENAME#.}"
done
[[ -n "$PROJECT_BASENAME" ]] || PROJECT_BASENAME="project"

if [[ "$AUTH_LOGIN" == "1" ]]; then
  SESSION_NAME="_auth"
elif [[ -z "$SESSION_NAME" ]]; then
  SESSION_SUFFIX="-${PROJECT_HASH}"
  # Per-agent default homes, so two agents on one project never collide.
  # Claude keeps the unsuffixed name existing session homes already use.
  [[ "$AGENT" != "claude" ]] && SESSION_SUFFIX="${SESSION_SUFFIX}-${AGENT}"
  # Keep the generated name inside the 120 characters the check below allows.
  PROJECT_BASENAME="${PROJECT_BASENAME:0:$((120 - ${#SESSION_SUFFIX}))}"
  SESSION_NAME="${PROJECT_BASENAME}${SESSION_SUFFIX}"
fi

# Charset, length, and the "." / ".." cases in one rule. Excluding a leading
# dot is what covers the last two: either would make HOME_DIR resolve to homes/
# or the whole state dir and mount sibling sessions, auth state, and memory.
if [[ ! "$SESSION_NAME" =~ ^[a-zA-Z0-9_-][a-zA-Z0-9_.-]{0,119}$ ]]; then
  echo "Invalid session name: '$SESSION_NAME'." >&2
  echo "Use 1 to 120 letters, digits, dots, underscores, or hyphens, not starting with a dot." >&2
  exit 1
fi

if [[ "$AUTH_LOGIN" == "1" ]]; then
  HOME_DIR="$AUTH_HOME_DIR"
else
  HOME_DIR="$STATE_DIR/homes/$SESSION_NAME"
fi

# Shared memory lives outside the per-session home. The default agent derives
# its memory key from the main worktree, so linked worktrees of one repository
# converge on the same host directory. The in-container path must follow the
# agent's cwd instead: claude derives its projects slug from where it runs.
PROJECT_MEMORY_KEY="$PROJECT_DIR"
AGENT_MEMORY_REL=""
CONTAINER_MEMORY_PATH=""
if [[ "$AGENT" == "claude" ]]; then
  [[ -n "$GIT_MAIN_WORKTREE" ]] && PROJECT_MEMORY_KEY="$GIT_MAIN_WORKTREE"
  project_memory_hash_full="$(printf '%s' "$PROJECT_MEMORY_KEY" | sha256_stream)"
  PROJECT_MEMORY_HASH="${project_memory_hash_full:0:12}"
  AGENT_MEMORY_SLUG="$(printf '%s' "$CONTAINER_PROJECT_DIR" | tr -c 'a-zA-Z0-9' '-')"
  AGENT_MEMORY_REL=".claude/projects/$AGENT_MEMORY_SLUG/memory"
  CONTAINER_MEMORY_PATH="/home/dev/$AGENT_MEMORY_REL"
else
  PROJECT_MEMORY_HASH="$PROJECT_HASH"
fi
PROJECT_MEMORY_DIR="$STATE_DIR/project-memory/$PROJECT_MEMORY_HASH"

if [[ "$MOUNT_VAULT" == "1" ]]; then
  if [[ -z "$VAULT_DIR" ]]; then
    echo "No vault configured. Use --vault=PATH or set AGENT_CAPSULE_VAULT." >&2
    exit 1
  fi

  if [[ "$VAULT_DEST" != /* || ! "$VAULT_DEST" =~ ^[A-Za-z0-9_/.-]+$ ]]; then
    echo "Invalid vault destination: $VAULT_DEST" >&2
    echo "It must be an absolute path of [A-Za-z0-9_/.-] characters." >&2
    exit 1
  fi
fi

CONTAINER_SUFFIX="${SESSION_NAME:0:48}"

# ----------------------------------------------------------------------------
# mcpvault
# ----------------------------------------------------------------------------
# The MCP server reads the vault straight off the filesystem, so it is useless
# without the vault mount. Registering it against a missing directory would only
# fail later, opaquely, at the first tool call.
MCPVAULT_ENABLED=0

# --no-vault keeps a configured integration overridable for one run.
if [[ ",$EXTRAS," == *,mcpvault,* ]]; then
  if [[ "$NO_VAULT" == "1" ]]; then
    echo ">> MCP     : mcpvault disabled for this run (--no-vault)" >&2
  elif [[ "$MOUNT_VAULT" != "1" ]]; then
    echo "--with mcpvault needs the vault mounted." >&2
    echo "Add --vault, or export AGENT_CAPSULE_MOUNT_VAULT=1." >&2
    exit 1
  else
    MCPVAULT_ENABLED=1
  fi
fi

# ----------------------------------------------------------------------------
# SELinux volume option
# ----------------------------------------------------------------------------
if [[ -n "${AGENT_CAPSULE_VOLOPT+x}" ]]; then
  VOL_OPT="$AGENT_CAPSULE_VOLOPT"
elif command -v selinuxenabled >/dev/null 2>&1 && selinuxenabled; then
  VOL_OPT="z"
else
  VOL_OPT=""
fi

# Stored without the leading colon; add_mount adds one where it concatenates.
VOL_OPT="${VOL_OPT#:}"

# Most mounts are shared across concurrent sessions (credentials, CLAUDE.md,
# project memory, vault) and need :z (shared relabel), never :Z (private
# per-container label): with :Z the second session would lose access.
[[ "$VOL_OPT" == "Z" ]] && VOL_OPT="z"

# The one place that knows how a -v argument is spelled.
MOUNT_ARGS=()
add_mount() { # src dest [ro]
  local opts="$VOL_OPT"

  [[ "${3:-}" == "ro" ]] && opts="${opts:+$opts,}ro"
  MOUNT_ARGS+=(-v "$1:$2${opts:+:$opts}")
}

# ----------------------------------------------------------------------------
# Prepare persistent dirs
# ----------------------------------------------------------------------------
# 0.1 kept one shared authentication home; 0.2 splits it per agent. Leaving the
# old one in place would silently mix two agents' credentials, so refuse. Every
# other 0.1 artifact is inert, and the README lists the migration steps.
if [[ -e "$AUTH_ROOT_DIR/.claude" ]]; then
  echo "Authentication state from agent-capsule 0.1: $AUTH_ROOT_DIR/.claude" >&2
  echo "No files were changed. Read the 'Upgrading from 0.1' section:" >&2
  echo "https://github.com/Niahh/agent-capsule#upgrading-from-01" >&2
  exit 1
fi

mkdir -p "$BUILD_DIR" "$AUTH_ROOT_DIR" "$AUTH_HOME_DIR" "$HOME_DIR"
chmod 700 "$STATE_DIR" "$AUTH_ROOT_DIR" "$AUTH_HOME_DIR" "$HOME_DIR" 2>/dev/null || true

[[ "$AUTH_LOGIN" == "1" ]] || ensure_session_agent_marker "$HOME_DIR"

ensure_minimal_gitconfig "$HOME_DIR"

copy_agent_auth_from_auth_home "$AUTH_HOME_DIR" "$HOME_DIR"

# Prepare the rules mount's target parent inside the session home.
if [[ "$SHARED_RULES_ENABLED" == "1" ]]; then
  mkdir -p "$HOME_DIR/$(dirname "$AGENT_RULES_REL")"
  RESOLVED_SHARED_RULES="$(resolve_file_path "$SHARED_RULES" "$SHARED_RULES_EXPLICIT")"
fi

# Prepare the shared memory dir and its in-container parent. Creating the parent
# host-side (rather than letting podman auto-create the mountpoint as root) keeps
# ownership correct under --keep-id, same as the rules parent above.
if [[ "$SHARED_MEMORY_ENABLED" == "1" ]]; then
  mkdir -p "$PROJECT_MEMORY_DIR"
  chmod 700 "$PROJECT_MEMORY_DIR" 2>/dev/null || true
  mkdir -p "$HOME_DIR/$(dirname "$AGENT_MEMORY_REL")"
fi

# Rewritten on every run: the vault destination can change between invocations.
if [[ "$MCPVAULT_ENABLED" == "1" ]]; then
  case "$AGENT_MCP_MODE" in
    flag)
      cat > "$HOME_DIR/$MCP_CONFIG_BASENAME" <<MCPCONFIG
{
  "mcpServers": {
    "obsidian": {
      "command": "mcpvault",
      "args": ["$VAULT_DEST"]
    }
  }
}
MCPCONFIG
      ;;
    env | override) ;;
  esac
fi

DOCKERFILE_SRC="$(resolve_dockerfile)"
DOCKERFILE_HASH="$(sha256_file "$DOCKERFILE_SRC")"
# The entrypoint ships beside the Dockerfile in every install layout, so
# resolve_dockerfile already found its directory.
ENTRYPOINT_SRC="$(dirname "$DOCKERFILE_SRC")/entrypoint.sh"
[[ -f "$ENTRYPOINT_SRC" ]] || {
  echo "Container entrypoint not found: $ENTRYPOINT_SRC" >&2
  exit 1
}
ENTRYPOINT_HASH="$(sha256_file "$ENTRYPOINT_SRC")"

# ----------------------------------------------------------------------------
# Build image if needed
# ----------------------------------------------------------------------------
# The image contains only the selected agent and integrations, so both belong
# in the hash: changing either has to invalidate the image.
HASH="$(printf '%s\n' \
  "$NODE_TAG" "$GO_TAG" "$AGENT" "$EXTRAS" "$CLAUDE_CODE_VERSION" "$CODEX_VERSION" \
  "$OPENCODE_VERSION" "$ANYDOC_VERSION" "$MCPVAULT_VERSION" "$SKILLS_VERSION" \
  "$SUPERPOWERS_VERSION" "$GOLANGCI_LINT_VERSION" \
  "$DOCKERFILE_HASH" "$ENTRYPOINT_HASH" | sha256_stream)"
BUILD_CONTEXT_DIR="$BUILD_DIR/context"

# Freshness is checked inside the lock only. An unlocked pre-check would save a
# podman image inspect on runs that do not build, at the cost of running the
# same query twice on the runs that do.
LOCK_ROOT="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/agent-capsule-$UID"
mkdir -p "$LOCK_ROOT"
chmod 700 "$LOCK_ROOT"
acquire_build_lock "$LOCK_ROOT/image.lock"

# The refresh label records the last pull plus no-cache build. Image creation
# time cannot represent that: cached selection builds create a new image without
# refreshing upstream tools, and Podman exposes .Created as an ISO 8601 string.
IMAGE_STATE="$(
  podman image inspect \
    --format '{{ index .Labels "io.agent-capsule.bundle" }} {{ index .Labels "io.agent-capsule.refreshed-at" }}' \
    "$IMAGE_REF" 2>/dev/null || true
)"
IMAGE_BUNDLE_HASH="${IMAGE_STATE%% *}"
IMAGE_REFRESHED_AT="${IMAGE_STATE##* }"

NEEDS_BUILD=0
REFRESH_REASON=""
if [[ "$FORCE_BUILD" == "1" ]]; then
  NEEDS_BUILD=1
  REFRESH_REASON=forced
elif [[ "$IMAGE_BUNDLE_HASH" != "$HASH" ]]; then
  NEEDS_BUILD=1
fi

# Missing or legacy metadata gets one full refresh even when age checks are
# disabled. The resulting label makes later AGENT_CAPSULE_MAX_IMAGE_AGE_DAYS=0
# launches stable.
if [[ ! "$IMAGE_REFRESHED_AT" =~ ^[0-9]+$ ]]; then
  REFRESH_REASON=metadata
elif refresh_is_stale "$IMAGE_REFRESHED_AT"; then
  REFRESH_REASON=stale
fi

if [[ -n "$REFRESH_REASON" ]]; then
  NEEDS_BUILD=1
fi

if [[ "$NEEDS_BUILD" == "1" ]]; then
  mkdir -p "$BUILD_CONTEXT_DIR"
  cp -f "$DOCKERFILE_SRC" "$BUILD_CONTEXT_DIR/Dockerfile"
  cp -f "$ENTRYPOINT_SRC" "$BUILD_CONTEXT_DIR/entrypoint.sh"
  chmod 0755 "$BUILD_CONTEXT_DIR/entrypoint.sh"
  BUILD_SELECTION_ARGS=(--build-arg "AGENT=$AGENT")
  for extra in "${KNOWN_EXTRAS[@]}"; do
    # anydoc -> WITH_ANYDOC, explain-diff -> WITH_EXPLAIN_DIFF.
    build_arg="WITH_$(printf '%s' "$extra" | tr 'a-z-' 'A-Z_')"
    if [[ ",$EXTRAS," == *",$extra,"* ]]; then
      BUILD_SELECTION_ARGS+=(--build-arg "$build_arg=1")
    else
      BUILD_SELECTION_ARGS+=(--build-arg "$build_arg=0")
    fi
  done

  build_note="$AGENT, ${EXTRAS:-no integrations}"
  BUILD_REFRESH_ARGS=()
  REFRESHED_AT="$IMAGE_REFRESHED_AT"
  # An unpinned install produces the same RUN string every time, so a refresh
  # has to bypass the layer cache or it reinstalls what is already there.
  if [[ -n "$REFRESH_REASON" ]]; then
    BUILD_REFRESH_ARGS=(--pull=always --no-cache)
    REFRESHED_AT="$(date +%s)"
    [[ "$REFRESH_REASON" == "stale" ]] &&
      build_note="$build_note; over $MAX_IMAGE_AGE_DAYS days old, refreshing"
  fi
  echo ">> Building $IMAGE_REF ($build_note)..."
  podman build \
    "${BUILD_REFRESH_ARGS[@]}" \
    --build-arg "NODE_TAG=$NODE_TAG" \
    --build-arg "GO_TAG=$GO_TAG" \
    --build-arg "CLAUDE_CODE_VERSION=$CLAUDE_CODE_VERSION" \
    --build-arg "CODEX_VERSION=$CODEX_VERSION" \
    --build-arg "OPENCODE_VERSION=$OPENCODE_VERSION" \
    --build-arg "ANYDOC_VERSION=$ANYDOC_VERSION" \
    --build-arg "MCPVAULT_VERSION=$MCPVAULT_VERSION" \
    --build-arg "SKILLS_VERSION=$SKILLS_VERSION" \
    --build-arg "SUPERPOWERS_VERSION=$SUPERPOWERS_VERSION" \
    --build-arg "GOLANGCI_LINT_VERSION=$GOLANGCI_LINT_VERSION" \
    "${BUILD_SELECTION_ARGS[@]}" \
    --label "io.agent-capsule.bundle=$HASH" \
    --label "io.agent-capsule.refreshed-at=$REFRESHED_AT" \
    --label "io.agent-capsule.selection=$AGENT:${EXTRAS:-none}" \
    -t "$IMAGE_REF" "$BUILD_CONTEXT_DIR"
  prune_superseded_images
fi
release_build_lock

# ----------------------------------------------------------------------------
# Command
# ----------------------------------------------------------------------------
# Not --strict-mcp-config: a project's own .mcp.json must keep working alongside
# the servers the capsule generates.
MCP_ARGS=()
if [[ "$MCPVAULT_ENABLED" == "1" ]]; then
  case "$AGENT_MCP_MODE" in
    flag) MCP_ARGS=(--mcp-config "$CONTAINER_MCP_CONFIG") ;;
    override)
      MCP_ARGS=(
        -c "mcp_servers.obsidian.command=\"mcpvault\""
        -c "mcp_servers.obsidian.args=[\"$VAULT_DEST\"]"
      )
      ;;
  esac
fi

INTEGRATION_ARGS=()
if [[ "$AGENT" == "claude" ]]; then
  if [[ ",$EXTRAS," == *,superpowers,* ]]; then
    INTEGRATION_ARGS+=(--plugin-dir /opt/superpowers/source)
  fi
  if [[ ",$EXTRAS," == *,anydoc,* ]]; then
    INTEGRATION_ARGS+=(--plugin-dir /opt/anydoc/plugin)
  fi
fi

# OpenCode merges inline configuration over its normal global and project
# files. This keeps capsule additions per invocation and leaves user files
# untouched. A local package path keeps Superpowers available offline.
OPENCODE_RUNTIME_CONFIG=""
if [[ "$AGENT" == "opencode" ]]; then
  OPENCODE_CONFIG_ITEMS=()
  if [[ ",$EXTRAS," == *,superpowers,* ]]; then
    OPENCODE_CONFIG_ITEMS+=('"plugin":["/opt/superpowers/source"]')
  fi
  if [[ "$MCPVAULT_ENABLED" == "1" ]]; then
    OPENCODE_CONFIG_ITEMS+=(
      "\"mcp\":{\"obsidian\":{\"type\":\"local\",\"command\":[\"mcpvault\",\"$VAULT_DEST\"]}}"
    )
  fi

  if [[ "${#OPENCODE_CONFIG_ITEMS[@]}" -gt 0 ]]; then
    OPENCODE_RUNTIME_CONFIG="{"
    for item in "${OPENCODE_CONFIG_ITEMS[@]}"; do
      [[ "$OPENCODE_RUNTIME_CONFIG" == "{" ]] || OPENCODE_RUNTIME_CONFIG+=","
      OPENCODE_RUNTIME_CONFIG+="$item"
    done
    OPENCODE_RUNTIME_CONFIG+="}"
  fi
fi

RUN_CMD=("$AGENT_BIN" "${INTEGRATION_ARGS[@]}" "${MCP_ARGS[@]}" "${AGENT_ARGS[@]}")
if [[ "$AUTH_LOGIN" == "1" ]]; then
  if [[ "$AGENT_AUTH_DEVICE_DEFAULT" == "1" && "${#AGENT_ARGS[@]}" -eq 0 ]]; then
    RUN_CMD=("${AGENT_AUTH_CMD[@]}" --device-auth)
  else
    RUN_CMD=("${AGENT_AUTH_CMD[@]}" "${AGENT_ARGS[@]}")
  fi
fi
[[ "$SHELL_MODE" == "1" ]] && RUN_CMD=(bash)

# ----------------------------------------------------------------------------
# Environment passed to container
# ----------------------------------------------------------------------------
ENV_ARGS=()

# The entrypoint activates only the integrations selected for this invocation.
ENV_ARGS+=(-e "AGENT_CAPSULE_AGENT=$AGENT")
ENV_ARGS+=(-e "AGENT_CAPSULE_WITH=$EXTRAS")
ENV_ARGS+=(-e "AGENT_CAPSULE_SKILLS_DIR=/home/dev/$AGENT_SKILLS_REL")

# Do not place the secret values directly in the podman command line.
for key in "${AGENT_ENV_PASS[@]}"; do
  if [[ -n "${!key:-}" ]]; then
    ENV_ARGS+=(-e "$key")
  fi
done

if [[ -n "$OPENCODE_RUNTIME_CONFIG" ]]; then
  ENV_ARGS+=(-e "OPENCODE_CONFIG_CONTENT=$OPENCODE_RUNTIME_CONFIG")
fi

# Herdr wrapper hint. The host foreground process is podman, while the agent
# runs inside the container.
export HERDR_AGENT="${HERDR_AGENT:-$AGENT}"
ENV_ARGS+=(-e "HERDR_AGENT=$HERDR_AGENT")

# ----------------------------------------------------------------------------
# Extra mounts: SRC[:DEST][:ro] -> -v SRC:DEST[:opts]
# ----------------------------------------------------------------------------
# The session home is the first mount; user mounts follow, then the rest.
add_mount "$HOME_DIR" /home/dev

for spec in "${MOUNT_SPECS[@]}"; do
  src="${spec%%:*}"
  rest="${spec#"$src"}"
  rest="${rest#:}"

  ro=0
  if [[ "$rest" == *:ro || "$rest" == "ro" ]]; then
    ro=1
    rest="${rest%ro}"
    rest="${rest%:}"
  fi

  dest="$rest"

  if [[ -d "$src" ]]; then
    resolved="$(cd -P "$src" 2>/dev/null && pwd)" || {
      echo "Mount source not found: $src" >&2
      exit 1
    }
  elif [[ -e "$src" ]]; then
    src_dir="$(dirname "$src")"
    src_base="$(basename "$src")"
    resolved_dir="$(cd -P "$src_dir" 2>/dev/null && pwd)" || {
      echo "Mount source not found: $src" >&2
      exit 1
    }
    resolved="$resolved_dir/$src_base"
  else
    echo "Mount source not found: $src" >&2
    exit 1
  fi
  src="$resolved"

  if [[ -z "$dest" ]]; then
    dest="/mnt/$(basename "$src")"
  fi

  if [[ "$dest" != /* ]]; then
    echo "Mount destination must be absolute: $dest" >&2
    exit 1
  fi

  if [[ "$ro" == "1" ]]; then
    add_mount "$src" "$dest" ro
    echo ">> Mount   : $src  ->  $dest (read-only)"
  else
    add_mount "$src" "$dest"
    echo ">> Mount   : $src  ->  $dest"
  fi
done

# Keep the working directory identical to its host path so Git worktree
# metadata remains portable across the bind boundary. /workspace remains as a
# compatibility alias for existing scripts and prompts.
add_mount "$PROJECT_DIR" "$CONTAINER_PROJECT_DIR"
if [[ "$CONTAINER_PROJECT_DIR" != "/workspace" ]]; then
  add_mount "$PROJECT_DIR" /workspace
fi

if [[ "$GIT_COMMON_EXTERNAL" == "1" ]]; then
  add_mount "$GIT_COMMON_DIR" "$GIT_COMMON_DIR"
fi

# ----------------------------------------------------------------------------
# Obsidian vault mount (--vault)
# ----------------------------------------------------------------------------
if [[ "$MOUNT_VAULT" == "1" ]]; then
  RESOLVED_VAULT="$(cd -P "$VAULT_DIR" 2>/dev/null && pwd)" || {
    echo "Vault not found: $VAULT_DIR" >&2
    echo "Create it or set AGENT_CAPSULE_VAULT to your vault's path." >&2
    exit 1
  }

  add_mount "$RESOLVED_VAULT" "$VAULT_DEST"
fi

# ----------------------------------------------------------------------------
# Shared global rules file mount
# ----------------------------------------------------------------------------
if [[ "$SHARED_RULES_ENABLED" == "1" ]]; then
  if [[ "$SHARED_RULES_READONLY" == "1" ]]; then
    add_mount "$RESOLVED_SHARED_RULES" "/home/dev/$AGENT_RULES_REL" ro
  else
    add_mount "$RESOLVED_SHARED_RULES" "/home/dev/$AGENT_RULES_REL"
  fi
fi

# ----------------------------------------------------------------------------
# Shared per-project memory mount
# ----------------------------------------------------------------------------
if [[ "$SHARED_MEMORY_ENABLED" == "1" ]]; then
  if [[ "$SHARED_MEMORY_READONLY" == "1" ]]; then
    add_mount "$PROJECT_MEMORY_DIR" "$CONTAINER_MEMORY_PATH" ro
  else
    add_mount "$PROJECT_MEMORY_DIR" "$CONTAINER_MEMORY_PATH"
  fi
fi

# ----------------------------------------------------------------------------
# Shared credentials live mount
# ----------------------------------------------------------------------------
# Bind-mount the ONE shared OAuth token (rw) into this session so a single
# `--auth-login` serves every session and in-container token refreshes write
# straight back to the shared file. Everything else in /home/dev stays isolated.
# Concurrency note: two sessions refreshing at the exact same instant race on
# this file (last-writer-wins). If the refresh rotates the refresh token, one
# session may need to refresh again. Acceptable for the herdr workflow; no lock.
SHARED_CRED_MOUNTED=0
AUTH_CRED_FILE="$AUTH_HOME_DIR/$AGENT_CRED_REL"
CONTAINER_CRED_PATH="/home/dev/$AGENT_CRED_REL"

if [[ "$SHARE_AUTH" == "1" && "$AUTH_LOGIN" != "1" ]]; then
  if [[ -s "$AUTH_CRED_FILE" ]]; then
    # The target parent must exist for the mount.
    mkdir -p "$HOME_DIR/$(dirname "$AGENT_CRED_REL")"
    add_mount "$AUTH_CRED_FILE" "$CONTAINER_CRED_PATH"
    SHARED_CRED_MOUNTED=1
  else
    echo ">> Auth    : no shared credentials yet. Run: agent-capsule --agent $AGENT --auth-login" >&2
  fi
fi

# ----------------------------------------------------------------------------
# User namespace
# ----------------------------------------------------------------------------
USER_ARGS=(--user "0:0")

if [[ "$KEEP_ID" == "1" ]]; then
  USER_ARGS=(
    --userns=keep-id
    --user "$(id -u):$(id -g)"
    -e HOME=/home/dev
  )
fi

# ----------------------------------------------------------------------------
# Security defaults
# ----------------------------------------------------------------------------
SECURITY_ARGS=(
  --security-opt=no-new-privileges
  --cap-drop=ALL
  --pids-limit="$DEFAULT_PIDS_LIMIT"
  --memory="$DEFAULT_MEMORY"
  --cpus="$DEFAULT_CPUS"
)

NETWORK_ARGS=()
if [[ "$OFFLINE" == "1" ]]; then
  NETWORK_ARGS=(--network=none)
fi

# Allocate a pseudo-TTY only when stdin is one; a bare -t breaks piped or
# batch runs (CI, herdr), e.g. `agent-capsule . -- -p "question" < prompt.txt`.
TTY_ARGS=(-i)
[[ -t 0 ]] && TTY_ARGS=(-it)

# ----------------------------------------------------------------------------
# Run
# ----------------------------------------------------------------------------
echo ">> Project : $PROJECT_DIR (working directory; also available at /workspace)"
if [[ "$GIT_COMMON_EXTERNAL" == "1" ]]; then
  echo ">> Git     : $GIT_COMMON_DIR (linked-worktree metadata)"
fi
echo ">> Session : $SESSION_NAME"
echo ">> State   : $HOME_DIR"
echo ">> Auth    : $AUTH_HOME_DIR"
if [[ "$SHARED_CRED_MOUNTED" == "1" ]]; then
  echo ">> Creds   : $AUTH_CRED_FILE -> $CONTAINER_CRED_PATH (shared, read-write)"
fi
# HERDR_AGENT can be pinned by the wrapper; when it diverges from --agent,
# show both rather than misreport what actually runs.
if [[ "$HERDR_AGENT" == "$AGENT" ]]; then
  echo ">> Agent   : $AGENT"
else
  echo ">> Agent   : $AGENT (HERDR_AGENT=$HERDR_AGENT)"
fi

if [[ -n "$EXTRAS" ]]; then
  echo ">> Extras  : ${EXTRAS//,/, }"
else
  echo ">> Extras  : none"
fi
echo ">> Image   : $IMAGE_REF"

if [[ "$SHARED_RULES_ENABLED" == "1" ]]; then
  md_mode="read-write"
  [[ "$SHARED_RULES_READONLY" == "1" ]] && md_mode="read-only"
  echo ">> Rules   : $RESOLVED_SHARED_RULES -> /home/dev/$AGENT_RULES_REL ($md_mode)"
else
  echo ">> Rules   : disabled"
fi

if [[ "$SHARED_MEMORY_ENABLED" == "1" ]]; then
  mem_mode="read-write"
  [[ "$SHARED_MEMORY_READONLY" == "1" ]] && mem_mode="read-only"
  echo ">> ProjMem : $PROJECT_MEMORY_DIR -> $CONTAINER_MEMORY_PATH (shared per-project, $mem_mode)"
elif [[ "$AGENT" != "claude" && "$AUTH_LOGIN" != "1" ]]; then
  echo ">> ProjMem : not supported by $AGENT"
fi

if [[ "$MOUNT_VAULT" == "1" ]]; then
  echo ">> Vault   : $RESOLVED_VAULT -> $VAULT_DEST (read-write)"
fi

if [[ "$MCPVAULT_ENABLED" == "1" ]]; then
  if [[ "$AGENT_MCP_MODE" == "flag" ]]; then
    if [[ "$SHELL_MODE" == "1" ]]; then
      echo ">> MCP     : mcpvault -> $VAULT_DEST (start it with: $AGENT_BIN --mcp-config $CONTAINER_MCP_CONFIG)"
    else
      echo ">> MCP     : mcpvault -> $VAULT_DEST (server 'obsidian')"
    fi
  elif [[ "$AGENT_MCP_MODE" == "override" ]]; then
    if [[ "$SHELL_MODE" == "1" ]]; then
      echo ">> MCP     : mcpvault -> $VAULT_DEST (start it with: codex -c" \
        "'mcp_servers.obsidian.command=\"mcpvault\"' -c" \
        "'mcp_servers.obsidian.args=[\"$VAULT_DEST\"]')"
    else
      echo ">> MCP     : mcpvault -> $VAULT_DEST (server 'obsidian', configuration overrides)"
    fi
  else
    if [[ "$SHELL_MODE" == "1" ]]; then
      echo ">> MCP     : mcpvault -> $VAULT_DEST (runtime config; start it with: $AGENT_BIN)"
    else
      echo ">> MCP     : mcpvault -> $VAULT_DEST (server 'obsidian', runtime config)"
    fi
  fi
fi

[[ "$AUTH_LOGIN" == "1" ]] && echo ">> Mode    : auth login"
if [[ "$AUTH_LOGIN" == "1" && "$AGENT" == "codex" ]]; then
  if [[ "$SHELL_MODE" == "1" ]]; then
    echo ">> Login   : shell mode; run the login by hand: codex login --device-auth"
  elif [[ "${#AGENT_ARGS[@]}" -eq 0 ]]; then
    echo ">> Login   : device-code flow; approve the code codex prints at the URL it shows, from any browser."
  else
    echo ">> Login   : custom login args; note the browser flow does not work" \
      "in the capsule (callback port unreachable)."
  fi
fi
[[ "$OFFLINE" == "1" ]] && echo ">> Network : disabled"

exec podman run "${TTY_ARGS[@]}" --rm --init \
  "${USER_ARGS[@]}" \
  "${SECURITY_ARGS[@]}" \
  "${NETWORK_ARGS[@]}" \
  --name "capsule-${CONTAINER_SUFFIX}-$$" \
  --label "ai.agent=$AGENT" \
  --label "ai.session=$SESSION_NAME" \
  -e TERM="${TERM:-xterm-256color}" \
  "${ENV_ARGS[@]}" \
  "${MOUNT_ARGS[@]}" \
  -w "$CONTAINER_PROJECT_DIR" \
  "$IMAGE_REF" "${RUN_CMD[@]}"
